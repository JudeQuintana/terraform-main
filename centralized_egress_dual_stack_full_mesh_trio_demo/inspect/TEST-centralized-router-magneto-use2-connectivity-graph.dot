graph connectivity {
  graph [rankdir=LR]
  node [shape=box, style=filled, fillcolor="#f0f0f0"]
  edge [fontsize=10]

  "app1"
  "general1"
  "infra1"

  "app1" -- "general1" [color="#95a5a6", label="default"]
  "app1" -- "infra1" [color="#95a5a6", label="default"]
  "general1" -- "infra1" [color="#95a5a6", label="default"]
}
