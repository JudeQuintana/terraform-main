graph connectivity {
  graph [rankdir=LR]
  node [shape=box, style=filled, fillcolor="#f0f0f0"]
  edge [fontsize=10]

  subgraph cluster_restricted {
    label="restricted"
    style=dashed
    color="#95a5a6"
    "app1"
  }
  subgraph cluster_shared {
    label="shared"
    style=dashed
    color="#95a5a6"
    "infra3"
    "app2"
  }
  "app3"
  "general1"
  "general2"
  "general3"
  "infra1"
  "infra2"

  "app2" -- "infra3" [color="#2ecc71", label="segment"]
  "infra1" -- "infra2" [color="#3498db", label="allow"]
}
